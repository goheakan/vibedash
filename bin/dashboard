#!/usr/bin/env bash
# Lance le tableau. Le dossier courant n'est pas changé.
# Moteur : ./dashboard-moteur/server.py s'il reste dans ce dossier,
# sinon moteur/server.py de ce dépôt.

set -euo pipefail

source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  if [[ "$source" != /* ]]; then
    source="$dir/$source"
  fi
done
root="$(cd "$(dirname "$source")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "erreur : python3 introuvable" >&2
  exit 1
fi

engine="$root/moteur/server.py"
local_dir="$PWD/dashboard-moteur"
local_engine="$local_dir/server.py"
if [ -e "$local_engine" ]; then
  resolved_engine="$(readlink -f -- "$local_engine")"
  resolved_dir="$(readlink -f -- "$local_dir")"
  case "$resolved_engine" in
    "$resolved_dir"/*)
      if [ -f "$resolved_engine" ]; then
        engine="$resolved_engine"
      fi
      ;;
  esac
fi

exec python3 -u "$engine" "$@"
